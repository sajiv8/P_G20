# ============================================================================
# .gitignore — Multi-Tenant Campus Resource Sharing Platform
# ============================================================================

# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
node_modules/


# ----------------------------------------------------------------------------
# Build Output
# ----------------------------------------------------------------------------
dist/
build/
*.js.map
*.tsbuildinfo

# ----------------------------------------------------------------------------
# Environment & Secrets (NEVER commit these)
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
backend/infra/.env

# Firebase service account keys
**/firebase-service-account.json
*-firebase-adminsdk-*.json

# Scripts with hardcoded secrets
backend/scripts/verify-rls.ts

# ----------------------------------------------------------------------------
# SSL Certificates
# ----------------------------------------------------------------------------
backend/infra/gateway/ssl/*.pem
infra/gateway/ssl/*.pem
nginx/ssl/
*.pem
*.key
*.crt
*.csr

# ----------------------------------------------------------------------------
# Sensitive / Credential Text Files
# ----------------------------------------------------------------------------
firebase.txt
keys.txt
supabase.txt
argoCD.txt
n8n.txt
supa base.txt
firebase sdk.txt
resend.txt
cloudflare.ini
github token 90 days.txt
API_ENDPOINTS_TESTING.md

# ----------------------------------------------------------------------------
# Tests, E2E & Mock Files
# ----------------------------------------------------------------------------
# NOTE: tests/ is intentionally NOT ignored — the Postman collection is a
# deliverable and CI cannot run what is not committed. Credentials live in
# tests/postman/campus-rso.postman_environment.json, ignored further down.
#
# The scripts below stay ignored because they contain hardcoded Firebase API
# keys and passwords. Move those values to environment variables, then commit
# the scripts.
e2e-puppeteer.mjs
backend/scripts/e2e-test.ts
backend/scripts/test-firebase-claims.ts
backend/services/user-service/test-token.js

# Test coverage
coverage/
.nyc_output/
*.lcov
.jest/

# ----------------------------------------------------------------------------
# Documentation (project-specific, not for Git)
# ----------------------------------------------------------------------------
n8n_integration_guide.md
n8n_chatbot_setup_guide_sinhala.md
n8n_chatbot_workflow.json
CI-CDGuide.md
productionCICD.md
DeploymentGuide.md
SRS document.md
Project_Proposal.md
Feasibility Report Template.md
architecture-diagrams.zip
architecture  document.md
interview-guide.md
DOCKER_SETUP.md

# ----------------------------------------------------------------------------
# n8n Deployment Scripts
# ----------------------------------------------------------------------------
n8n-deploy-chatbot.mjs
backend/scripts/n8n-deploy-chatbot.mjs

# ----------------------------------------------------------------------------
# OS Files
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.lnk

# ----------------------------------------------------------------------------
# IDE / Editor
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ----------------------------------------------------------------------------
# Temp / Cache
# ----------------------------------------------------------------------------
tmp/
temp/
.cache/
.parcel-cache/
*.bak
*.orig
*.tmp

# ----------------------------------------------------------------------------
# Docker (local volumes & overrides)
# ----------------------------------------------------------------------------
docker-compose.override.yml
backend/docs/


# Postman environment with real credentials (copy from the .example file)
tests/postman/campus-rso.postman_environment.json
tests/postman/newman-report.html

# Cypress — credentials and run artifacts
cypress.env.json
tests/cypress/screenshots/
tests/cypress/videos/
tests/cypress/downloads/

# JMeter run artifacts
tests/jmeter/results/

# ZAP scan reports
tests/security/reports/

# Real SUS responses (keep participant data out of git)
tests/usability/responses.csv
