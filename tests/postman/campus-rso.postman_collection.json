{
  "info": {
    "name": "CampusRSO API",
    "description": "API test suite for the Campus Resource Sharing Platform. Runs through the Nginx gateway, so it exercises routing, rate limiting and every service together.\n\nRun order matters: the Auth folder stores ID tokens that later requests reuse.\n\nCommand line:\n  npx newman run tests/postman/campus-rso.postman_collection.json -e tests/postman/campus-rso.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "studentToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "resourceId", "value": "" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Gateway is up",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/health", "host": ["{{gatewayUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('responds in under 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Sign in as student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": ["identitytoolkit", "googleapis", "com"],
              "path": ["v1", "accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseApiKey}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sign in succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an ID token', () => pm.expect(body.idToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('studentToken', body.idToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as tenant admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseApiKey}}",
              "protocol": "https",
              "host": ["identitytoolkit", "googleapis", "com"],
              "path": ["v1", "accounts:signInWithPassword"],
              "query": [{ "key": "key", "value": "{{firebaseApiKey}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sign in succeeds', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().idToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Security",
      "item": [
        {
          "name": "TC-AUTH-14 No token is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/api/v1/tenants/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "tenants", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', () => pm.response.to.have.status(401));",
                  "pm.test('error code is AUTH_MISSING_TOKEN', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_MISSING_TOKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-AUTH-15 Malformed token is rejected",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-real-token" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/tenants/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "tenants", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', () => pm.response.to.have.status(401));",
                  "pm.test('does not leak a stack trace', () => pm.expect(pm.response.text()).to.not.include('at '));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-RBAC-01 Student cannot create a resource",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorised Resource\",\n  \"resource_type\": \"lab\",\n  \"capacity\": 10\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/v1/resources/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "resources", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 403', () => pm.response.to.have.status(403));",
                  "// Services are inconsistent here: the shared requireRole guard returns",
                  "// INSUFFICIENT_ROLE, while resource-service raises its own FORBIDDEN.",
                  "pm.test('denies with a forbidden error code', () => pm.expect(pm.response.json().error.code).to.be.oneOf(['INSUFFICIENT_ROLE', 'FORBIDDEN']));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-SEC-16 Unknown path returns 404 without detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/nonexistent/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "nonexistent", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('returns 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Profile and tenants",
      "item": [
        {
          "name": "Get own profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/users/me", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "const profile = pm.response.json().data;",
                  "pm.test('is a student', () => pm.expect(profile.role).to.eql('student'));",
                  "pm.test('belongs to a faculty', () => pm.expect(profile.tenant_id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get own token balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/users/me/tokens", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "users", "me", "tokens"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "const balance = pm.response.json().data.balance;",
                  "pm.test('balance is never negative', () => pm.expect(balance === null || balance.balance >= 0).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "List tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/tenants/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "tenants", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Resources",
      "item": [
        {
          "name": "List resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/resources/?limit=20",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "resources", ""],
              "query": [{ "key": "limit", "value": "20" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "const resources = pm.response.json().data;",
                  "pm.test('returns an array', () => pm.expect(resources).to.be.an('array'));",
                  "const equipment = resources.find(r => r.category === 'EQUIPMENT' && r.is_bookable && r.status === 'available');",
                  "if (equipment) { pm.collectionVariables.set('resourceId', equipment.id); }",
                  "pm.test('a bookable equipment item exists for later tests', () => pm.expect(equipment, 'seed at least one available EQUIPMENT resource').to.not.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-24 Page size is capped at 100",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings/?limit=500",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "bookings", ""],
              "query": [{ "key": "limit", "value": "500" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('limit is clamped to 100', () => pm.expect(pm.response.json().meta.limit).to.eql(100));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Bookings",
      "item": [
        {
          "name": "TC-BOOK-13 Missing fields are rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"resource_id\": \"{{resourceId}}\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/api/v1/bookings/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "bookings", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('names the missing fields', () => pm.expect(pm.response.json().error.message).to.include('required'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-01 Student creates a booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": \"{{resourceId}}\",\n  \"title\": \"Newman API Test Booking\",\n  \"purpose\": \"Automated API test\",\n  \"start_time\": \"{{slotStart}}\",\n  \"end_time\": \"{{slotEnd}}\",\n  \"attendee_count\": 1\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/v1/bookings/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "bookings", ""] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Book a unique far-future slot so repeated runs never collide.",
                  "const start = new Date();",
                  "start.setFullYear(start.getFullYear() + 1);",
                  "start.setMilliseconds(0);",
                  "start.setSeconds(0);",
                  "start.setMinutes(0);",
                  "const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('slotStart', start.toISOString());",
                  "pm.collectionVariables.set('slotEnd', end.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "const booking = pm.response.json().data;",
                  "pm.test('student booking starts as pending', () => pm.expect(booking.status).to.eql('pending'));",
                  "pm.test('returns a booking id', () => pm.expect(booking.id).to.be.a('string'));",
                  "pm.collectionVariables.set('bookingId', booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-04 Same slot is refused with 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": \"{{resourceId}}\",\n  \"title\": \"Conflicting Booking\",\n  \"start_time\": \"{{slotStart}}\",\n  \"end_time\": \"{{slotEnd}}\",\n  \"attendee_count\": 1\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/v1/bookings/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "bookings", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 409', () => pm.response.to.have.status(409));",
                  "pm.test('explains the conflict', () => pm.expect(pm.response.json().error.message.toLowerCase()).to.include('priority'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-10 Adjacent slot is allowed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource_id\": \"{{resourceId}}\",\n  \"title\": \"Adjacent Booking\",\n  \"start_time\": \"{{slotEnd}}\",\n  \"end_time\": \"{{adjacentEnd}}\",\n  \"attendee_count\": 1\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/api/v1/bookings/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "bookings", ""] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = new Date(pm.collectionVariables.get('slotEnd'));",
                  "pm.collectionVariables.set('adjacentEnd', new Date(end.getTime() + 60 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('touching edges do not count as an overlap', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adjacentBookingId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-17 Admin approves the booking",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings/{{bookingId}}/approve",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('status becomes approved', () => pm.expect(pm.response.json().data.status).to.eql('approved'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-18 Approving twice returns 404",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings/{{bookingId}}/approve",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('an approved booking is no longer pending', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        },
        {
          "name": "TC-BOOK-20 Owner cancels the booking",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings/{{bookingId}}/cancel",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('status becomes cancelled', () => pm.expect(pm.response.json().data.status).to.eql('cancelled'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Clean up the adjacent booking",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings/{{adjacentBookingId}}/cancel",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "bookings", "{{adjacentBookingId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('test data is cleaned up', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Notifications",
      "item": [
        {
          "name": "TC-NOT-01 Booking events produce notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{gatewayUrl}}/api/v1/notifications/", "host": ["{{gatewayUrl}}"], "path": ["api", "v1", "notifications", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-NOT-04 Unread count is a number",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/notifications/unread-count",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "v1", "notifications", "unread-count"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('count is never negative', () => pm.expect(pm.response.json().data.unread_count).to.be.at.least(0));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
